{
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/api",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs(.*)",
      "destination": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "API_PREFIX": "/api/v1",
    "CORS_ORIGIN": "*",
    "DATA_DIR": "/tmp/data"
  }
}
