# Server Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*,http://localhost:5000
JWT_ACCESS_SECRET=food_delivery_jwt_access_super_secret_key_2026_production_grade
JWT_REFRESH_SECRET=food_delivery_jwt_refresh_super_secret_key_2026_production_grade
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Persistence
DATA_DIR=./data

# Payment Provider
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=whsec_food_delivery_secure_webhook_key_2026
